import sys
sys.path.insert(0, "/home/heimdall/btc_proj/BTC_analysis/btc_engine")
import pandas as pd
import numpy as np

base = "/home/heimdall/btc_proj/BTC_analysis/btc_engine/results/research/empirical-baseline-fixed-20260729T005016Z"

# 1. RECOMPUTE spot P&L for unhedged from spot data
spots = pd.read_csv(f"{base}/_spot_data_dump.csv")
start_close = spots['close'].iloc[0]
end_close = spots['close'].iloc[-1]
min_close = spots['close'].min()
max_close = spots['close'].max()
print(f"=== SPOT DATA RECOMPUTATION ===")
print(f"Start: {start_close:.2f}")
print(f"End: {end_close:.2f}")
print(f"Min: {min_close:.2f}")
print(f"Max: {max_close:.2f}")
print(f"Observed buy-and-hold return: {((end_close / start_close) - 1) * 100:.2f}%")
print(f"Return from reference $65k to end: {((end_close / 65000) - 1) * 100:.2f}%")

# 2. OOS results - check if they have values
oos = pd.read_parquet(f"{base}/oos_results.parquet")
print(f"\n=== OOS RESULTS ===")
for col in oos.columns:
    print(f"  {col}: {oos[col].tolist()}")

# 3. Regime details
reg = pd.read_parquet(f"{base}/regime_results.parquet")
print(f"\n=== REGIME DETAILS ===")
print(f"Total regimes: {len(reg)}")
print(reg[['regime_name', 'regime_label', 'annualised_return', 'annualised_vol']].to_string())

# 4. Stress details
stress = pd.read_parquet(f"{base}/stress_results.parquet")
print(f"\n=== STRESS BY STRATEGY ===")
for s in stress['strategy_id'].unique():
    ss = stress[stress['strategy_id'] == s]
    print(f"  {s}: {len(ss)} scenarios")
    worst = ss.loc[ss['strategy_pnl_usd'].idxmin()]
    best = ss.loc[ss['strategy_pnl_usd'].idxmax()]
    print(f"    Best: {best['scenario_name']} = ${best['strategy_pnl_usd']:,.0f}")
    print(f"    Worst: {worst['scenario_name']} = ${worst['strategy_pnl_usd']:,.0f}")

# 5. Backtest cycle-level aggregation  
bt = pd.read_parquet(f"{base}/backtest_results.parquet")
print(f"\n=== BACKTEST CYCLE AGGREGATION ===")
ref_notional = 30000 * 65000
print(f"Reference notional: ${ref_notional:,.0f}")

for s in bt['strategy_id'].unique():
    sb = bt[bt['strategy_id'] == s]
    sum_pnl = sb['net_pnl_usd'].sum()
    sum_prem = sb['premium_received_usd'].sum()
    sum_fees = sb['total_fees_usd'].sum()
    pnl_pct = (sum_pnl / ref_notional) * 100
    prem_pct = (sum_prem / ref_notional) * 100
    fee_pct = (sum_fees / ref_notional) * 100
    
    # Compute spot delta from cycle entries/exits
    spot_delta = ((sb['expiry_spot'] - sb['entry_spot']) * 30000).sum()
    spot_delta_pct = (spot_delta / ref_notional) * 100
    
    print(f"\n  {s}:")
    print(f"    Σ net_pnl: ${sum_pnl:,.0f} ({pnl_pct:.2f}%)")
    print(f"    Σ premium: ${sum_prem:,.0f} ({prem_pct:.2f}%)")
    print(f"    Σ fees: ${sum_fees:,.0f} ({fee_pct:.2f}%)")
    print(f"    Σ spot Δ P&L: ${spot_delta:,.0f} ({spot_delta_pct:.2f}%)")
    print(f"    Cycles: {len(sb)}, ITM count: {sb['is_itm'].sum()}")

# 6. For unhedged, reconstruct what the strategy comparison says
comp = pd.read_csv(f"{base}/strategy_comparison.csv")
print(f"\n=== STRATEGY COMPARISON CSV ===")
for _, row in comp.iterrows():
    print(f"\n  {row['strategy_id']}:")
    print(f"    total_pnl_pct: {row['total_pnl_pct']:.2f}%")
    print(f"    total_premium_usd: ${row['total_premium_usd']:,.0f}")
    print(f"    effective_acquisition_cost: ${row['effective_acquisition_cost']:,.2f}")
    print(f"    max_drawdown_pct: {row['max_drawdown_pct']:.4f}%")
    print(f"    sharpe_ratio: {row['sharpe_ratio']}")
    print(f"    itm_frequency: {row['itm_frequency']}")
    print(f"    var_95_loss: ${row['var_95_loss']:,.0f}")
    print(f"    es_975_loss: ${row['es_975_loss']:,.0f}")

# 7. Verify the unhedged P&L by computing actually
# If unhedged buys at reference 65k and settles at end:
unhedged_pnl = (end_close - 65000) * 30000
unhedged_pnl_pct = (unhedged_pnl / ref_notional) * 100
print(f"\n=== UNHEDGED P&L RECOMPUTATION ===")
print(f"Buy at $65k, sell at end ${end_close:.2f}:")
print(f"  30,000 * ({end_close:.2f} - 65,000) = ${unhedged_pnl:,.0f}")
print(f"  Pct: {unhedged_pnl_pct:.2f}%")

# If unhedged buys at observed start 66771 and sells at end:
unhedged_pnl2 = (end_close - start_close) * 30000
unhedged_pnl2_pct = (unhedged_pnl2 / (start_close * 30000)) * 100
print(f"\nBuy at obs start ${start_close:.2f}, sell at end ${end_close:.2f}:")
print(f"  30,000 * ({end_close:.2f} - {start_close:.2f}) = ${unhedged_pnl2:,.0f}")
print(f"  Pct of start value: {unhedged_pnl2_pct:.2f}%")

# What denominator gives -56.2% if delta is from 65k to some point?
# -0.562 = (end_price - 65000) / 65000, end_price = 65000 * 0.438 = 28470
# But the observed end is 63694. Let's check what combination gives -56.2%
# Maybe it's the SUM of all cycle P&L percentages:
# Let me check if all cycles combined give -56.2%
all_cycles_delta = 0
for s in bt['strategy_id'].unique():
    sb = bt[bt['strategy_id'] == s]
    delta = ((sb['expiry_spot'] - sb['entry_spot']) * 30000).sum()
    all_cycles_delta += delta
print(f"\nSum of all cycle spot deltas: ${all_cycles_delta:,.0f}")
print(f"Pct of ref notional: {all_cycles_delta/ref_notional*100:.2f}%")

# Check if the unhedged spot delta IS the delta from all cycles summed somehow
