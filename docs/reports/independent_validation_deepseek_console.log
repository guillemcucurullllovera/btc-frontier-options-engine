import sys
sys.path.insert(0, "/home/heimdall/btc_proj/BTC_analysis/btc_engine")
import pandas as pd
import numpy as np

base = "/home/heimdall/btc_proj/BTC_analysis/btc_engine/results/research/empirical-baseline-fixed-20260729T005016Z"

# Read spot data
spots = pd.read_csv(f"{base}/_spot_data_dump.csv")
spots['timestamp'] = pd.to_datetime(spots['timestamp'])
ref_notional = 30000 * 65000  # 1,950,000,000
ref_spot = 65000

# Read backtest data
bt = pd.read_parquet(f"{base}/backtest_results.parquet")

# For each strategy with long BTC, compute: what would be the pure spot P&L
# if we held 30k BTC from reference spot start to each cycle's end?
# And sum across cycles?
print("=== CHECKING P&L COMPUTATIONS ===")

# APPROACH: Use the backtest cycle entry/exits to reconstruct
# First, look at ONE strategy (covered_call) cycle by cycle

sb = bt[bt['strategy_id'] == 'covered_call']
print("Covered call cycles:")
print(f"  Cycles: {len(sb)}")
print(f"  First cycle: entry={sb.iloc[0]['entry_spot']:.2f}, expiry={sb.iloc[0]['expiry_spot']:.2f}, pnl={sb.iloc[0]['net_pnl_usd']:,.0f}, pnl_pct={sb.iloc[0]['net_pnl_pct']:.4f}%")

# The BTC P&L for a cycle is (expiry_spot - entry_spot) * 30000
# Sum this across all cycles:
btc_cycle_pnl = ((sb['expiry_spot'] - sb['entry_spot']) * 30000).sum()
btc_cycle_pnl_pct = btc_cycle_pnl / ref_notional * 100
print(f"  Sum of BTC Δ P&L (cycle-wise): ${btc_cycle_pnl:,.0f} ({btc_cycle_pnl_pct:.2f}%)")

# But this double-counts! Each cycle's entry ~= previous cycle's expiry
# (not exactly due to calendar differences)
# The actual continuous P&L should be close to first_entry→last_expiry
first_entry = sb.iloc[0]['entry_spot']
last_expiry = sb.iloc[-1]['expiry_spot']
continuous_btc_pnl = (last_expiry - first_entry) * 30000
continuous_btc_pnl_pct = continuous_btc_pnl / ref_notional * 100
print(f"  Continuous BTC P&L (first_entry→last_expiry): ${continuous_btc_pnl:,.0f} ({continuous_btc_pnl_pct:.2f}%)")

# Sum of per-cycle net_pnl_usd
sum_net = sb['net_pnl_usd'].sum()
sum_net_pct = sum_net / ref_notional * 100
print(f"  Sum of net P&L: ${sum_net:,.0f} ({sum_net_pct:.2f}%)")
print(f"  Strategy_comparison reports: +11.26%")

# What is the difference between spot delta and net P&L?
# Premium - fees
prem = sb['premium_received_usd'].sum()
fees = sb['total_fees_usd'].sum()
print(f"  Premium: ${prem:,.0f}")
print(f"  Fees: ${fees:,.0f}")
print(f"  BTC Δ + Premium - Fees = {btc_cycle_pnl:,.0f} + {prem:,.0f} - {fees:,.0f} = {btc_cycle_pnl + prem - fees:,.0f}")
print(f"  Actual net sum = {sum_net:,.0f}")

# Now check: how is unhedged -56.2% computed?
# The report says it buys at reference spot $65k and holds
# But buy-and-hold from ref=65k to end=63694 gives -2.01%

# What if unhedged buys at ref=65k and the "P&L" is 
# computed from the sum of (expiry_spot - ref_spot) for each cycle?
# Even though BTC is only bought once?
sum_expiry_vs_ref = ((sb['expiry_spot'] - ref_spot) * 30000).sum()
print(f"\n=== UNHEDGED P&L INVESTIGATION ===")
print(f"Sum of (expiry - ref) * 30000 across 24 cycles: ${sum_expiry_vs_ref:,.0f}")
print(f"  Pct: {sum_expiry_vs_ref/ref_notional*100:.2f}%")

# What about using the STRATEGY-level computation?
# Maybe unhedged P&L = (end_spot - ref_spot) * 30000 but with some other end spot?
# Check individual cycle expiry spots
for i in range(len(sb)):
    c = sb.iloc[i]
