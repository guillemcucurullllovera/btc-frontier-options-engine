import pandas as pd
import numpy as np

base = "/home/heimdall/btc_proj/BTC_analysis/btc_engine/results/research/empirical-baseline-fixed-20260729T005016Z"
bt = pd.read_parquet(f"{base}/backtest_results.parquet")

# Premium unit analysis
# The report says:
# - "Total premium received = $11.34B" for covered call
# - premium_received_usd in backtest is 11,341,760,165 in binary (11.34B)
# But let's check: premium per cycle should be around BS ATM 15% OTM at 30 DTE, 45% vol
# BS call premium for S=65000, K=74750, T=30/365, r=0.04, σ=0.45
# per contract (= 1 BTC notional)
# Then * 30000 contracts

print("=== PREMIUM UNIT ANALYSIS ===")
ref_notional = 30000 * 65000
print(f"Reference notional: ${ref_notional:,.0f}")

sb = bt[bt['strategy_id'] == 'covered_call']
print(f"\nCovered call cycles: {len(sb)}")

# premium_received_usd is PER CYCLE
# premium_received_btc is also per cycle
for i in range(min(5, len(sb))):
    c = sb.iloc[i]
    print(f"  C{i}: prem_usd={c['premium_received_usd']:>15,.0f} prem_btc={c['premium_received_btc']:>10.2f} entry={c['entry_spot']:.2f}")
    # Check: prem_usd / prem_btc should ≈ entry_spot (if prem_btc is in BTC units)
    if c['premium_received_btc'] > 0:
        implied_spot = c['premium_received_usd'] / c['premium_received_btc']
        print(f"        implied_spot={implied_spot:.2f} vs entry_spot={c['entry_spot']:.2f}")

# What should per-cycle premium be?
# BS European call: K = S * (1 + 0.15) = 74750 for S=65000
# For the first cycle: S=66771.45, K=75000 (rounded?)
# T = 30/365.25 ≈ 0.082
# Let me not compute BS right now, just check relationships

# Now: the TOTAL premium for covered call is $11.34B (11,341,760,165)
# But looking at JUST the premium per cycle:
sum_prem = sb['premium_received_usd'].sum()
print(f"\nSum of premium across cycles: ${sum_prem:,.0f}")
print(f"Per-cycle avg premium: ${sum_prem/len(sb):,.0f}")
print(f"Per-BTC avg premium per cycle: ${sum_prem/len(sb)/30000:,.2f}")
print(f"Per-BTC avg premium as % of spot: {sum_prem/len(sb)/30000/65000*100:.2f}%")

# The report says $11.34B total for covered call. This is indeed the sum.
# But $11.34B for 30000 BTC over 24 cycles means
# $11.34B / 24 cycles = $472.5M per cycle
# $472.5M / 30000 BTC = $15,750 per BTC per cycle
# $15,750 / $65,000 = 24.2% per cycle per BTC!!!

# That's absurd. BS premium at 15% OTM, 30 DTE, 45% vol should be ~1%.
# Something is VERY wrong with the premium numbers.

# Let me check: is premium_received_usd per contract (1 BTC) or per total position?
# If prem_usd = ~$15,000/BTC/cycle, that would be BS premium IF it's per entire position
#   vs if prem_btc = ~400 BTC, then the implied spot is about right ($28M / 430 = $65k)

# Look at cycle 0: prem_usd=$28,690,350, prem_btc=429.68
# 28,690,350 / 429.68 = 66,771 which matches entry_spot!
# So prem_btc = prem_usd / entry_spot, meaning prem_btc is the BTC-equivalent of the premium.
# And prem_usd = 28,690,350 for 30,000 contracts.

# Per-BTC premium: 28,690,350 / 30,000 = $956.35/BTC
# As % of entry: 956.35 / 66,771 = 1.43%
# That's about right for BS 15% OTM call!

# So $956/BTC/cycle × 24 cycles = $22,952/BTC total
# 30,000 BTC × 24 = $0.72B? No...
# Wait: 30,000 BTC × 24 cycles means each cycle covers 30,000 BTC.
# Total premium = sum over 24 cycles of (per_BTC_premium × 30,000)
# = avg $956 × 30,000 × 24 = $688M? But the sum is $11.34B!

# That means per-BTC premium is much higher than expected.
# Let me compute: $11.34B / 24 / 30000 = $15,750/BTC/cycle

# Something doesn't add up. Let me look at actual cycle premiums more carefully.

print(f"\n=== DETAILED PREMIUM CHECK ===")
for i, c in sb.iterrows():
    prem = c['premium_received_usd']
    prem_per_btc = prem / 30000
    prem_pct = prem_per_btc / c['entry_spot'] * 100
    print(f"  C{i}: prem=${prem:>20,.0f} per_btc=${prem_per_btc:>10.2f} pct={prem_pct:.2f}%")

