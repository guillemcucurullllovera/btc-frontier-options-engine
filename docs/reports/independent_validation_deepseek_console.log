import csv
from pathlib import Path
from datetime import datetime

path = Path("/home/heimdall/btc_proj/BTC_analysis/btc_engine/results/research/empirical-baseline-fixed-20260729T005016Z/_spot_data_dump.csv")

with open(path) as f:
    reader = csv.DictReader(f)
    rows = list(reader)

timestamps = []
closes = []
for r in rows:
    timestamps.append(r['timestamp'])
    closes.append(float(r['close']))

print(f"Total rows: {len(rows)}")
print(f"Start: {timestamps[0]} close={closes[0]:.2f}")
print(f"End:   {timestamps[-1]} close={closes[-1]:.2f}")
print(f"Min: {min(closes):.2f} at idx {closes.index(min(closes))}")
print(f"Max: {max(closes):.2f} at idx {closes.index(max(closes))}")

# Buy-and-hold return from observed first to observed last
start_close = closes[0]
end_close = closes[-1]
simple_ret = (end_close - start_close) / start_close * 100
print(f"\nObserved buy-and-hold return (start→end): {simple_ret:.2f}%")

# Return relative to reference spot 65000
ref_spot = 65000.0
ref_ret = (end_close - ref_spot) / ref_spot * 100
print(f"Return from reference spot ($65,000)→end: {ref_ret:.2f}%")

# Check if there are any values around 28000 (would give -56% from 65000)
# Actually -56.2% from 65000 means end price around 28470
# Or -56.2% from 66771 means end price around 29268
print(f"\n65000 * (1 - 0.562) = {65000 * (1 - 0.562):.2f}")
print(f"66771 * (1 - 0.562) = {66771 * (1 - 0.562):.2f}")

# Let's see if the spot ever reaches ~28470
for i, c in enumerate(closes):
    if c < 30000:
        print(f"  Spot below 30k at {timestamps[i]}: {c:.2f}")

# Check average over the period
print(f"\nMean close: {sum(closes)/len(closes):.2f}")

# Check first few and last few observations to verify window
print(f"\nFirst 5: {closes[:5]}")
print(f"Last 5: {closes[-5:]}")
